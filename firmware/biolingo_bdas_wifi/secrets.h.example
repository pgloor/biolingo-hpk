// Copy to secrets.h (git-ignored) and fill in. 2.4 GHz networks only - the ESP32 cannot join 5 GHz.
// The box tries the networks in this order. Put the one you control FIRST:
// it is used whenever it is there; the second one is only a fallback.
#define WIFI_SSID_1  "your-phone-hotspot"
#define WIFI_PASS_1  "hotspot-password"
#define WIFI_SSID_2  "venue-wifi"
#define WIFI_PASS_2  "venue-password"
// Shared secret; must match BIOLINGO_TOKEN in the server's systemd unit.
#define DEVICE_TOKEN "replace-with-32-hex-chars"
