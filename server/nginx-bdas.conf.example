# /etc/nginx/sites-available/bdas  -> bdas.biolingo.org
# Classroom live view for the BDAS course. Exposes ONLY the page and the
# endpoints it needs; the /api/bdas/* routes only ever return biolingo-bdas-*
# boxes. Everything else on the HPK server stays behind hpk.biolingo.org's login.
server {
    listen 80;
    server_name bdas.biolingo.org;

    # Optional: password-protect the page (students would need it on phones).
    # sudo htpasswd -c /etc/nginx/.htpasswd-bdas bdas
    # auth_basic "BDAS";
    # auth_basic_user_file /etc/nginx/.htpasswd-bdas;

    location = /                  { proxy_pass http://127.0.0.1:8080/bdas$is_args$args; }
    location = /api/live          { proxy_pass http://127.0.0.1:8080; }
    location = /api/status        { proxy_pass http://127.0.0.1:8080; }
    location = /api/events_recent { proxy_pass http://127.0.0.1:8080; }
    location = /api/event         { limit_except POST { deny all; } proxy_pass http://127.0.0.1:8080; }
    location ^~ /api/bdas/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_buffering off;          # stream the ZIP instead of buffering it
        proxy_read_timeout 300s;
    }
    location / { return 404; }
}
